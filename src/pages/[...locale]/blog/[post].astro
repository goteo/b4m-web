---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../components/App.svelte";
import ReturnHeader from "../../../components/library/ReturnHeader.svelte";
import BodyText from "../../../components/library/BodyText.svelte";

const { t, lang, session } = Astro.locals;
const { post } = Astro.params;

const markdownFiles = import.meta.glob<{ default: any }>("../../../../static/blog/*md");

const fileKey = Object.keys(markdownFiles).find((path) => path.endsWith(`${post}.md`));

if (!fileKey) {
    return Astro.redirect("/404");
}

const file = await markdownFiles[fileKey]();

const Content = file.default;
---

<Layout title={t("metadata.title")} description={t("metadata.description")}>
    <App client:load locale={lang} session={session} class="mb-20">
        <ReturnHeader client:load />
        <BodyText client:load>
            <Content />
        </BodyText>
    </App>
</Layout>
